<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.12</version>
    <relativePath/>
  </parent>
  <groupId>com.heima</groupId>
  <artifactId>hmall</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>山野装备</name>
  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <modules>
    <module>hm-common</module>
    <module>user-service</module>
    <module>item-service</module>
    <module>cart-service</module>
    <module>trade-service</module>
    <module>pay-service</module>
    <module>hm-gateway</module>
  </modules>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <includes>
          <include>outdoor*.yml</include>
          <include>outdoor*.sql</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>17</release>
          <includes>
            <include>com/hmall/outdoor/**/*.java</include>
          </includes>
          <testIncludes>
            <testInclude>com/hmall/outdoor/**/*.java</testInclude>
          </testIncludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
